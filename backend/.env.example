AVALAI_API_KEY=replace-with-your-avalai-api-key
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_EMBEDDING_TIMEOUT=60
AVALAI_MAX_RATE_RETRIES=20

EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
EMBEDDING_WORKERS=6
EMBEDDING_REQUESTS_PER_MINUTE=120

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=liara_documentation_hybrid
QDRANT_HYBRID_COLLECTION=liara_documentation_hybrid

RAG_MODEL=gpt-5.6-terra
AVALAI_LLM_TIMEOUT=900
RAG_MAX_CONTEXT_CHARS=18000

DATABASE_URL=postgresql://chatbot:chatbot@postgres:5432/chatbot
CHAT_MEMORY_MESSAGES=20
CHAT_MEMORY_MAX_CHARS=16000
