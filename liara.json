{
  "port": 8000,
  "build": {
    "dockerfile": "./Dockerfile",
    "cache": true
  },
  "docker": {
    "timezone": "Asia/Tehran"
  },
  "healthCheck": {
    "command": "CMD python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5).read()\"",
    "interval": 30000,
    "timeout": 10000,
    "retries": 5,
    "startPeriod": 30000
  }
}
